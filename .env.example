# Expo client values (safe to embed in the application bundle)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-side administrator bootstrap only. Never prefix these with EXPO_PUBLIC.
# Keep them in a local environment or secret manager and never commit values.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_INITIAL_PASSWORD=

# Supabase Management API + SMTP (required once to enable code-based emails)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_SENDER_EMAIL=
AUTH_SMTP_SENDER_NAME=Smart Trike

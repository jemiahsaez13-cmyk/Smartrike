{
  "expo": {
    "name": "Smart Trike",
    "slug": "smart-trike",
    "version": "1.0.0",
    "scheme": "smarttrike",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.smarttrike.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAPwLes_QZQNKO0AdUI2jsF-qHT4a-Xkjg"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-location",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Smart Trike needs access to your photos so you can set a profile picture."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "42488411-c12e-483c-a40b-313a335e10ce"
      }
    },
    "owner": "elpieee"
  }
}

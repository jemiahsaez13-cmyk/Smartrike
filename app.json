{
  "expo": {
    "name": "Smart Trike",
    "slug": "smart-trike",
    "version": "1.0.0",
    "scheme": "smarttrike",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3B634E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.smarttrike.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3B634E"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAPwLes_QZQNKO0AdUI2jsF-qHT4a-Xkjg"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-location",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/splash-icon.png",
          "color": "#3B634E"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Smart Trike needs photo access for profile pictures, payment QR codes, and payment proof uploads."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "42488411-c12e-483c-a40b-313a335e10ce"
      }
    },
    "owner": "elpieee"
  }
}
